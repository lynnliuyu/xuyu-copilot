# ===== 百度网盘开放平台 =====
BDPAN_APP_ID=124070117
BDPAN_APP_KEY=
BDPAN_SECRET_KEY=
BDPAN_SIGN_KEY=

# 应用名 = 网盘里「我的应用数据/<应用名>」的文件夹名，对应 API 路径 /apps/<应用名>
# 必填，否则所有文件操作无法确定根目录
BDPAN_APP_NAME=

# 授权回调地址。填 oob 表示使用百度展示授权码的方式（无需公网回调，最快）
BDPAN_REDIRECT_URI=oob

# 是否强制把文件操作限制在 /apps/<应用名> 之内。true = 越界直接拒绝
BDPAN_SCOPE_STRICT=true

# listall 最小调用间隔（毫秒）。官方建议不超过 8~10 次/分钟
BDPAN_LISTALL_INTERVAL_MS=6500

# 付费的分享能力总开关。未开通分享权限前请保持 false，避免误调用返回 13998
#
# ⚠️ 注意适用范围：它只影响**我们自己的应用**（packages/bdpan-core）调用分享接口。
#    流水线实际出链接走的是官方 bdpan CLI（`bdpan share`）——那条路**不看这个开关**，
#    因为背后是官方 Skill 自己已购买能力的应用。别把它当成"分享总闸"。
BDPAN_SHARE_ENABLED=false

# ===== 闲管家开放平台 =====
# 获取路径：闲管家 → 开放平台 → 订购 ERP 专业版/铂金版 → 创建应用 → 应用上线
# ⚠️ 应用类型决定方向，两者互不通用：
#    ·「进销存」  = 我们调闲管家（发商品/上架/拉订单）→ 用 GOOFISH_APP_KEY 调 /api/open/*
#    ·「虚拟货源」= 闲管家调我们（拉商品/下单发货）→ 用 GOOFISH_APP_KEY 验签 /goofish/*
#    ·「虚拟货源」的应用调 /api/open/* 会返回 100001，这不是配置错误
GOOFISH_APP_KEY=
GOOFISH_APP_SECRET=

# 商务对接模式才需要；自研/第三方 ERP 对接留空（留空时签名不带这一段）
GOOFISH_SELLER_ID=

# 上架/商品状态变更的推送地址。官方明确「上架存在发布失败的可能」，
# 强烈建议填一个公网 HTTPS 地址接收结果；不填就只能去后台看列表
GOOFISH_NOTIFY_URL=

# 写操作总开关（第二道闸门）。false 时 gf:publish 一律走 dry-run。
# 即使设为 true，命令行仍需显式加 --live 才会真正调用写接口。
GOOFISH_LIVE=false

# 单账号 QPS 上限，官方 = 10
GOOFISH_QPS=10

# ===== 闲管家「虚拟货源」网关（闲管家 → 我们）=====
# 仅当应用类型为「虚拟货源 / 自研系统」时需要。签名规则与开放平台完全不同：
#   sign = md5(app_id, app_secret, md5(body), timestamp, mch_id, mch_secret)
# 【重要】下面两个值是**我们自己随便定义**的，然后原文填进闲管家的「货源授权信息」：
#   XGJ_MCH_ID     → 填到闲管家的「AppKey」字段（签名里叫 mch_id）
#   XGJ_MCH_SECRET → 填到闲管家的「AppSecret」字段（签名里叫 mch_secret）
# 建议 mch_secret 用 32 位随机串
XGJ_MCH_ID=
XGJ_MCH_SECRET=

# 网关监听端口
XGJ_PORT=8787

# 是否按官方公布的闲管家 IP 段校验来源。网关暴露公网后建议开启
XGJ_IP_WHITELIST=false

# 时间戳容忍窗口（秒）。官方 = 300（5 分钟）
XGJ_TIMESTAMP_TOLERANCE=300

# 数据目录（catalog.json / cards.json / orders.json 所在）。部署时建议指向挂载卷
# XGJ_DATA_DIR=/var/lib/xgj-gateway

# ===== 商品图图床（自有服务器）=====
# 商品图必须能从公网抓到，闲鱼侧才肯收。这里走 SSH + scp 传到自有静态站。
MEDIA_SSH_TARGET=                 # 形如 root@1.2.3.4
MEDIA_SSH_KEY=                    # 私钥文件绝对路径
MEDIA_REMOTE_DIR=                 # 远端静态目录，如 /srv/goods-img
MEDIA_PUBLIC_BASE=                # 对外前缀，如 https://api.fmkj.top/goods

# ===== 进销存应用（另一套凭证，与虚拟货源不通用）=====
# 「进销存」应用才有 /api/open/* 权限（发商品、上架、拉订单）。
# ⚠️ 与上面虚拟货源那套的 key/secret 完全不同，混用会得到含糊的 100001。
GOOFISH_ERP_APP_KEY=
GOOFISH_ERP_APP_SECRET=

# ===== 本地后台管理端 =====
# 只绑 127.0.0.1，不对外。能改价格、改卡密、发布商品，绝不暴露公网。
# ADMIN_PORT=8790

# ── 公网入口：SSH 反向隧道（替代 Cloudflare Quick Tunnel）──
# 闲管家 → https://<固定域名> (自有服务器 Caddy) → handle /goofish/*
#          → reverse_proxy 127.0.0.1:<TUNNEL_REMOTE_PORT> → 本机网关
TUNNEL_SSH_HOST=
TUNNEL_SSH_KEY=
TUNNEL_REMOTE_PORT=8787
TUNNEL_LOCAL_PORT=8787
GOOFISH_PUBLIC_URL=
