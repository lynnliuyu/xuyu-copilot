{
  "name": "bdpan-goofish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "auth": "npm run auth -w @bdpan/core",
    "probe": "npm run probe -w @bdpan/core",
    "whoami": "npm run whoami -w @bdpan/core",
    "scan": "npm run scan -w @bdpan/core",
    "mcp": "npm run start -w @bdpan/mcp-server",
    "gf:ping": "tsx packages/goofish-adapter/src/cli/ping.ts",
    "gf:shop": "tsx packages/goofish-adapter/src/cli/shop.ts",
    "gf:categories": "tsx packages/goofish-adapter/src/cli/categories.ts",
    "gf:preview": "tsx packages/goofish-adapter/src/cli/preview.ts",
    "gf:publish": "tsx packages/goofish-adapter/src/cli/publish.ts",
    "gw": "npm run serve -w @bdpan/xgj-gateway",
    "gw:test": "npm run selftest -w @bdpan/xgj-gateway",
    "gw:import": "tsx packages/xgj-gateway/src/cli/import-goods.ts",
    "gw:goods": "tsx scripts/goods.ts",
    "card:sync": "tsx scripts/card-sync.ts",
    "check:delivery": "tsx scripts/check-delivery.ts",
    "order:probe": "tsx scripts/order-probe.ts",
    "republish": "tsx scripts/republish-stuck.ts",
    "publish:queue": "tsx scripts/publish-queue.ts",
    "preflight": "tsx scripts/preflight.ts",
    "ops": "tsx scripts/ops-check.ts",
    "watch:tunnel": "tsx scripts/watch-tunnel.ts",
    "tunnel:ssh": "node scripts/tunnel-ssh.mjs",
    "gw:up": "docker compose up -d --build",
    "gw:down": "docker compose down",
    "gw:restart": "docker compose restart",
    "gw:ps": "docker compose ps",
    "gw:logs": "docker compose logs -f --tail=80",
    "stack:up": "bash scripts/docker-stack-up.sh",
    "ocr:gate": "node scripts/ocr-gate-test.mjs",
    "ocr:diff": "node scripts/ocr-diff.mjs",
    "ocr:diff:report": "node scripts/ocr-diff-report.mjs",
    "tunnel:url": "bash scripts/tunnel-url.sh",
    "verify:sign": "tsx scripts/verify-sign.ts",
    "verify:sign-vs": "tsx scripts/verify-sign-vs.ts",
    "tree": "tsx scripts/tree.ts",
    "inspect": "tsx scripts/inspect.ts",
    "organize": "tsx scripts/organize.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run test",
    "admin": "tsx packages/xgj-admin/src/server.ts",
    "media": "tsx scripts/media.ts",
    "soft:tree": "tsx scripts/software-tree.ts",
    "soft:423": "node assets/423down-software/collect.mjs",
    "soft:mac": "node assets/mac-software/collect.mjs",
    "soft:repack": "node assets/repackmac/collect.mjs",
    "fetch:free": "node scripts/fetch-free-software.mjs",
    "fetch:par": "bash scripts/fetch-parallel.sh",
    "tree:netdisk": "node scripts/netdisk-tree.mjs",
    "media:netdisk": "node scripts/netdisk-media.mjs",
    "site:netdisk": "node scripts/netdisk-site.mjs",
    "push:free": "node scripts/push-free-to-netdisk.mjs",
    "push:multi": "node scripts/push-multi-to-netdisk.mjs",
    "rename:account": "node scripts/set-account-name.mjs",
    "gh:audit": "node scripts/gh-audit.mjs",
    "gh:watch": "node scripts/gh-watch.mjs",
    "wechat:serve": "node scripts/wechat-reply-server.mjs",
    "wechat:selftest": "node scripts/wechat-reply-server.mjs --selftest",
    "wechat:agent": "bash scripts/install-agents.sh",
    "agents:install": "bash scripts/install-agents.sh",
    "share:netdisk": "node scripts/netdisk-share.mjs",
    "share:sync": "node scripts/sync-share-links.mjs",
    "push:license": "node scripts/push-license-to-netdisk.mjs",
    "video": "bash scripts/video.sh",
    "video:cards": "bash scripts/video-cards.sh",
    "mp": "bash scripts/mp.sh",
    "mp:cover": "bash scripts/mp-cover.sh",
    "mp:article": "node scripts/article-to-mp.mjs",
    "mp:verify": "node scripts/verify-mp-article.mjs",
    "mp:probe": "node scripts/mp-wechat-draft.mjs --probe",
    "mp:draft": "node scripts/mp-wechat-draft.mjs --push",
    "mp:drafts": "node scripts/mp-wechat-draft.mjs --list",
    "cat:icons": "node scripts/netdisk-cat-icons.mjs",
    "need:images": "node scripts/netdisk-need-images.mjs",
    "cover:inbox": "node scripts/netdisk-cover-inbox.mjs",
    "fetch:covers": "node scripts/netdisk-fetch-covers.mjs",
    "sync:listings": "tsx scripts/listings-sync-all.ts",
    "kami:auto": "tsx scripts/kami-auto.ts",
    "kami:bind": "tsx scripts/kami-bind.ts",
    "consign:auto": "node scripts/consign-auto.mjs",
    "consign:api": "node scripts/consign-api.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "jimp": "^0.22.12",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
