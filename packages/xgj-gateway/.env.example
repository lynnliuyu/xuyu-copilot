# 闲管家「虚拟货源」网关 —— 配置模板
#
#   cp .env.example .env
#
# ⚠️ 两组值来源不同，别搞混（这是最常见的对接失败原因）：
#    XGJ_MCH_ID / XGJ_MCH_SECRET          ← 由**你自定义**，再填进闲管家
#    GOOFISH_APP_KEY / GOOFISH_APP_SECRET ← 闲管家「应用概况」给出的

# ── 货源授权信息（你自定义，然后填进闲管家后台）
# 闲管家「应用详情 › 货源授权信息」里：
#   AppKey    = XGJ_MCH_ID
#   AppSecret = XGJ_MCH_SECRET
# 自研系统只有一个商户，取一组值即可。官方原话：
# 「mch_secret 能保证签名不易破解即可」，建议 32 位随机串。
XGJ_MCH_ID=my-shop-001
XGJ_MCH_SECRET=请替换为32位随机串请替换为32位随机串

# ── 闲管家应用（应用概况里给出的，用于验签）
# 「查询平台信息」会把这个 AppKey 原样回传给闲管家做校验
GOOFISH_APP_KEY=
GOOFISH_APP_SECRET=

# ── 可选
XGJ_PORT=8787
# 宿主机映射端口 / 绑定地址
XGJ_HOST_PORT=8787
XGJ_HOST_BIND=0.0.0.0
# 反向代理后面必须保持 false（X-Forwarded-For 可伪造）
XGJ_IP_WHITELIST=false
XGJ_TIMESTAMP_TOLERANCE=300
XGJ_LOG_BODY=true
# 拉不动 Docker Hub 时改成 node:22-slim
NODE_IMAGE=node:22-alpine
